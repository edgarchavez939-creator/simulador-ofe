# PLANTILLA Linux: copiar fuera del repositorio a /etc/ofe/ofe.env.
# Completar el dominio real antes de iniciar. No incluye contraseñas.
# El proyecto NO carga archivos .env automáticamente: usar node --env-file=...
NODE_ENV=production
APP_ORIGIN=https://simulador.ejemplo.invalid
HOST=127.0.0.1
PORT=8787
OFE_DATABASE=/var/lib/ofe/ofe.sqlite
OFE_PUBLIC_ENABLED=1
OFE_PUBLIC_FRAME_ORIGINS="https://www.uninorte.edu.co"

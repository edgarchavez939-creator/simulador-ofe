# PLANTILLA Docker: copiar fuera del repositorio y completar el dominio real.
# Pasar con docker run --env-file; montar un volumen persistente en /app/var.
NODE_ENV=production
APP_ORIGIN=https://simulador.ejemplo.invalid
HOST=0.0.0.0
PORT=8787
OFE_DATABASE=/app/var/ofe.sqlite
OFE_PUBLIC_ENABLED=1
OFE_PUBLIC_FRAME_ORIGINS=https://www.uninorte.edu.co
